{
  "name": "bank-elhaz",
  "version": "1.0.0",
  "type": "module",
  "description": "Bank El Haz — Online multiplayer (also includes local hot-seat)",
  "scripts": {
    "dev": "node -e \"import('child_process').then(({spawn})=>{const s=spawn('npx',['tsx','src/server/index.ts'],{stdio:'inherit'});const c=spawn('npx',['vite','--port','5173'],{stdio:'inherit'});process.on('SIGINT',()=>{s.kill();c.kill();process.exit()})})\"",
    "server": "tsx src/server/index.ts",
    "client": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:soak": "vitest run tests/soak",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.0.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.3.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.5"
  }
}
